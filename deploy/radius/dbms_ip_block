#  FreeRADIUS 3 policy: block an attacker's IP for 2 days after one login with an unknown username.
#
#  When someone tries to log in to a device (SSH/Telnet to a router, say) with a username that is
#  NOT in the RADIUS database (radcheck) and NOT in the allowed list below, the address they connect
#  FROM is written to dbms_ip_block for 2 days. While it is there, every login from that address is
#  rejected, even with a correct username and password.
#
#  The attacker's address comes from Calling-Station-Id, which routers/switches fill with the remote
#  IP of an SSH/Telnet login (Cisco, Huawei, Juniper ...). A request without an IP in Calling-Station-Id
#  is never blocked - the device's own address (Packet-Src-IP-Address) is NOT used, or one bad login
#  would lock everybody out of that device.
#
#  The login that causes the block is shown under Device logins as usual; the later attempts from a
#  blocked address are NOT written there (it would fill up with an attacker's tries) - they are counted
#  in the "hits" of its Blocked IPs row instead.
#
#  Never blocked: private / loopback addresses (10/8, 172.16/12, 192.168/16, 127/8), so an administrator
#  who mistypes a username on the office network is not locked out. Unblock early on
#  RADIUS / AAA -> Authentication Audit -> Blocked IPs.
#
#  Note: FreeRADIUS only answers the device's question; it cannot stop the attacker from reaching the
#  device. To stop the connections themselves, also put an ACL on the device's VTY lines.
#
#  Installed by deploy/install.sh, which replaces __ALLOW_USERS__ with RADIUS_BLOCK_ALLOW_USERS from
#  .env (comma-separated; default "hasuk"): local device accounts that are not in the RADIUS database.
#  By hand (Debian/Ubuntu paths):
#    1. python manage.py radius_init                  (creates the dbms_ip_block table)
#    2. sed "s/__ALLOW_USERS__/'hasuk'/" deploy/radius/dbms_ip_block > /etc/freeradius/3.0/policy.d/dbms_ip_block
#    3. In /etc/freeradius/3.0/sites-enabled/default, inside "authorize { ... }", add directly AFTER
#       the "-sql" (or "sql") line:
#           dbms_ip_block
#    4. sudo freeradius -XC   then   sudo systemctl restart freeradius

dbms_ip_block {
	if ((&Calling-Station-Id) && ("%{Calling-Station-Id}" =~ /^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$|^[0-9A-Fa-f:]*:[0-9A-Fa-f:.]+$/) && ("%{Calling-Station-Id}" !~ /^(10\.|127\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|::1$|[Ff][CcDd]|[Ff][Ee]80:)/)) {
		# already blocked -> reject at once. Written so that a failed query (table missing, database down)
		# gives "" and blocks nobody.
		if ("%{sql:SELECT CASE WHEN COUNT(*) > 0 THEN 'blocked' ELSE 'ok' END FROM dbms_ip_block WHERE ip = '%{Calling-Station-Id}' AND blocked_until > NOW()}" == "blocked") {
			# counted here instead of a new row in radpostauth: Tmp-String-8 tells Post-Auth-Type REJECT
			# (sites-enabled/default, set up by enable_ip_block.sh) to skip the sql login log
			update control {
				&Tmp-String-9 := "%{sql:UPDATE dbms_ip_block SET hits = hits + 1, last_username = '%{User-Name}', last_seen = NOW() WHERE ip = '%{Calling-Station-Id}'}"
				&Tmp-String-8 := "dbms-blocked"
			}
			update reply {
				&Reply-Message := "Login from this address is blocked"
			}
			reject
		}
		# unknown username (not in the RADIUS database, not an allowed local account) -> block for 2 days
		elsif ("%{sql:SELECT CASE WHEN '%{User-Name}' IN (__ALLOW_USERS__) OR EXISTS (SELECT 1 FROM radcheck WHERE username = '%{User-Name}') THEN 'known' ELSE 'unknown' END}" == "unknown") {
			update control {
				&Tmp-String-9 := "%{sql:INSERT INTO dbms_ip_block (ip, first_username, last_username, nasname, hits, created_at, last_seen, blocked_until) VALUES ('%{Calling-Station-Id}', '%{User-Name}', '%{User-Name}', '%{Packet-Src-IP-Address}', 1, NOW(), NOW(), NOW() + INTERVAL 2 DAY) ON DUPLICATE KEY UPDATE first_username = VALUES(first_username), last_username = VALUES(last_username), nasname = VALUES(nasname), hits = hits + 1, created_at = NOW(), last_seen = NOW(), blocked_until = NOW() + INTERVAL 2 DAY}"
			}
			update reply {
				&Reply-Message := "Unknown user; this address is now blocked"
			}
			reject
		}
	}
}
